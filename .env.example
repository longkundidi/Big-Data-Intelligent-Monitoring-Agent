# Docker Compose deployment settings. Copy this file to .env on the server.
# Never commit the real .env file or API key.
AGENT_MODEL_API_KEY=
AGENT_MODEL_BASE_URL=http://38.71.118.183:8080/v1
AGENT_MODEL_NAME=gpt-6-astra
AGENT_REASONING_EFFORT=high

# Optional observation sources. The defaults in compose.agent.yml already point
# to the services on the internal streamdoctor_default Docker network.
MODEL_HEALTH_URL=http://regtcn-model:8000/healthz
AGENT_MODEL_METRICS_LOG=
AGENT_LOG_PATH=

# Stateful service credentials. Set real values in the server-side .env only.
MYSQL_ROOT_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
