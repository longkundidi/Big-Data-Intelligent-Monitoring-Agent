<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="sw.model3d.configAlarmInfo.mapper.ConfigAlarmInfoMapper">

  <resultMap id="configAlarmInfoMap" type="sw.model3d.configAlarmInfo.entity.DcAlarm">
    <id property="id" column="id"/>
    <result property="dcData" column="dc_data"/>
    <result property="turbineCode" column="turbine_code"/>
    <result property="taskId" column="task_id"/>
    <result property="dcTime" column="dc_time"/>
    <result property="algoShortname" column="algo_shortname"/>
    <result property="anomalyFlag" column="anomaly_flag"/>
  </resultMap>

  <select id="selectDistinctTaskIdsLast24Hours" resultType="String">
    SELECT DISTINCT task_id
    FROM dc_alarm
    WHERE dc_time >= NOW() - INTERVAL 24 HOUR
  </select>
</mapper>
