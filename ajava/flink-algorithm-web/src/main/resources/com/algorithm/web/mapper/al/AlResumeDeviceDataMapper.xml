<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.algorithm.web.mapper.al.AlResumeDeviceDataMapper">

  <resultMap id="alResumeDataMap" type="com.algorithm.web.model.entity.al.AlResumeDeviceData">
    <id property="id" column="id"/>
    <result property="projectId" column="project_id"/>
    <result property="deviceId" column="device_id"/>
  </resultMap>

  <select id="getFengji" resultType="java.lang.String">
    select device_id from al_resume_device_data where project_id=#{project_id}
  </select>

</mapper>
