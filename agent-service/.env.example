# Defaults bind the service to loopback and keep automatic polling off.
AGENT_DB_PATH=./streamdoctor.db
AGENT_TOPOLOGY_PATH=./topology.json
AGENT_POLL_ENABLED=false
FLINK_REST_URL=http://127.0.0.1:8081
KAFKA_SERVERS=127.0.0.1:9092
# A dedicated JSON health endpoint, not the model's POST inference URL.
MODEL_HEALTH_URL=http://127.0.0.1:8873/healthz
# Optional local PyFlink log copied/streamed from the isolated job.
AGENT_MODEL_METRICS_LOG=
AGENT_LOG_PATH=
AGENT_PROJECT_SCAN_ROOT=
# OpenAI Responses API. The API key stays on the server and is never returned to the browser.
AGENT_MODEL_API_KEY=
AGENT_MODEL_BASE_URL=
AGENT_MODEL_NAME=gpt-6-astra
AGENT_REASONING_EFFORT=high
# Reuse the non-secret model, effort and Responses endpoint from ~/.codex/config.toml when AGENT_MODEL_* is absent.
AGENT_USE_CODEX_CONFIG=true
# Required for non-loopback access; gateway bearer JWT issuer/audience.
AGENT_JWKS_URL=
AGENT_JWT_ISSUER=
AGENT_JWT_AUDIENCE=
# Comma-separated CIDRs used only when the service port is bound to loopback.
AGENT_TRUSTED_NETWORKS=
