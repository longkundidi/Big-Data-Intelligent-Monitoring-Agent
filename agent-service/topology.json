  "flink_job_name": "algorithm_REGTCN",
  "consumer_group": "REGTCN_kafka_group",
  "input_topic": "dc_algorithm_REGTCN",
  "output_topic": "dc_algorithm_sink_REGTCN",
  "nodes": [
    {"id": "source", "label": "电梯数据模拟器", "type": "source"},
