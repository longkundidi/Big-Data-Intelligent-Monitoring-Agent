    {"id": "job", "label": "REGTCN Flink 作业", "type": "flink", "registry_key": "elevator-monitor"},
    {"id": "model", "label": "REGTCN 模型服务", "type": "model", "registry_key": "elevator-monitor-model"},
    {"id": "output", "label": "输出 Kafka", "type": "kafka", "topic": "dc_algorithm_sink_REGTCN"},
    {"id": "sink", "label": "结果入库", "type": "sink", "registry_key": "elevator-result-sink"}
